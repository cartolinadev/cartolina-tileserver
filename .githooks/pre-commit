#!/usr/bin/env sh
#
# Block commits that would leak PII or secrets. Scans the staged diff for
# common sensitive patterns. Set SKIP_SENSITIVE=1 to bypass for a known
# false positive.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks
#
# Patterns avoid '\+' and in-class '\-' so they work with both GNU grep and
# ugrep ('[+]' for a literal plus; '-' placed last in a character class).

# Added lines of the staged diff (excluding the '+++' file headers).
added() {
  git diff --cached | grep -E '^[+]' | grep -v '^[+][+][+]'
}

fail_sensitive() {
  echo "pre-commit: sensitive content detected — $1"
  echo "Commit blocked. Fix the issue or set SKIP_SENSITIVE=1 to bypass."
  exit 1
}

if [ -z "$SKIP_SENSITIVE" ]; then
  ADDED=$(added)

  # Absolute home directory paths
  if echo "$ADDED" | grep -qE '/home/[a-zA-Z0-9_]+/'; then
    fail_sensitive "absolute /home/ path in staged changes"
  fi

  # Common secret token prefixes / private keys
  if echo "$ADDED" | grep -qE \
        'sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]+|glpat-[A-Za-z0-9-]+'\
'|xoxb-[0-9A-Za-z-]+|AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC )?PRIVATE'; then
    fail_sensitive "secret token or private key in staged changes"
  fi

  # Quoted key/password assignments (a quoted value of >=8 chars)
  if echo "$ADDED" | grep -iqE \
        '(api_?key|password|passwd|auth_?key|secret)[ ]*[=:][ ]*['"'"'"][^'"'"'"]{8,}['"'"'"]'; then
    fail_sensitive "key/password assignment in staged changes"
  fi

  # .env-style unquoted assignments (an unquoted value of >=8 chars)
  if echo "$ADDED" | grep -qE \
        '^[+][A-Z_]*(API_KEY|PASSWORD|SECRET|AUTH_KEY|PASSWD)[A-Z_]*=[A-Za-z0-9+/=_-]{8,}'; then
    fail_sensitive ".env key/password assignment in staged changes"
  fi

  # IPv4 addresses (public or private).
  # Strip quoted dotted-decimal strings first to avoid flagging version
  # numbers like "1.0.0.4" that appear in JSON or build output.
  if echo "$ADDED" \
      | grep -vE '"[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}"' \
      | grep -qE \
        '\b(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b'; then
    fail_sensitive "IPv4 address in staged changes"
  fi
fi

exit 0
